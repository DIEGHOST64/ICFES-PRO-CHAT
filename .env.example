# ─────────────────────────────────────────────────────────
# IcfesProject — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# ─────────────────────────────────────────────────────────

# PostgreSQL
DB_DATABASE=icfes_db
DB_USERNAME=icfes_user
DB_PASSWORD=icfes_secret_password

# Laravel (generar con: docker exec icfes_backend php artisan key:generate --show)
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Modelos opcionales (si no se definen, usan los de arriba como fallback)
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
