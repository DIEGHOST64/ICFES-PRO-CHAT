# ─────────────────────────────────────────
# Variables de entorno – IcfesProject
# Copiar como .env y completar los valores
# ─────────────────────────────────────────

# PostgreSQL
DB_DATABASE=icfes_db
DB_USERNAME=icfes_user
DB_PASSWORD=icfes_secret_password

# Laravel
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
