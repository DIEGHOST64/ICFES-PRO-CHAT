# ─────────────────────────────────────────────────────────
# IcfesProject — Variables de entorno (RAÍZ)
# ─────────────────────────────────────────────────────────
# 1. Copia este archivo como .env:  copy .env.example .env
# 2. Reemplaza los placeholders con valores reales.
# 3. NUNCA commitees el .env real — ya está en .gitignore.
# ─────────────────────────────────────────────────────────

# PostgreSQL
DB_DATABASE=icfes_db
DB_USERNAME=icfes_user
DB_PASSWORD=<TU_CONTRASEÑA_SEGURA>

# Laravel — GENERAR con:
#   docker compose up -d backend
#   docker exec icfes_backend php artisan key:generate --show
# Copiar el resultado aquí (incluyendo "base64:"):
APP_KEY=<GENERAR_CON: php artisan key:generate --show>

# Google Gemini — obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=<TU_API_KEY_DE_GOOGLE_AI_STUDIO>
GEMINI_MODEL=gemini-2.5-flash

# Modelos opcionales
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
